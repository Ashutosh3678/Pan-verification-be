PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/oneinfo_db

# OneInfo Authentication (Send this value in 'x-api-key' request header)
ONEINFO_MASTER_API_KEY=oneinfo_secret_key_123

# Cashfree Sandbox Credentials (Mode: sandbox)
CASHFREE_SANDBOX_CLIENT_ID=your_sandbox_client_id
CASHFREE_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret

# Cashfree Production Credentials (Mode: prod)
CASHFREE_PROD_CLIENT_ID=your_prod_client_id
CASHFREE_PROD_CLIENT_SECRET=your_prod_client_secret

# ==========================================
# PRODUCTION GUARDRAILS & LIMITS
# ==========================================
# Feature Flags (Kill-switches): set to false to stop live calls immediately
ENABLE_PROD_PAN=true
ENABLE_PROD_AADHAAR=true

# Daily Production Quota Limits (Max live calls per calendar day)
PROD_PAN_DAILY_LIMIT=100
PROD_AADHAAR_DAILY_LIMIT=50

# Rate Limiting (Max live calls per minute per client)
PROD_RATE_LIMIT_PER_MINUTE=10
